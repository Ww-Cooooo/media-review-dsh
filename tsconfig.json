{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
